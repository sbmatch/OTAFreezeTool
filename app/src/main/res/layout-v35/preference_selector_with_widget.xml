<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 15 (expressive) 下的 SelectorWithWidgetPreference 布局覆盖。

    库里的版本把 checkbox 的 widget_frame 设成 minWidth=56dp + paddingHorizontal=20dp，
    再叠加分组卡片 32dp 的内容内边距后，checkbox 会明显偏向中间；
    同时空着的 icon_frame 又给标题留了 48dp 空白。
    这里改成和 settingslib_expressive_preference 一致的间距。
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="?android:attr/listPreferredItemHeightSmall"
    android:background="?android:attr/selectableItemBackground"
    android:baselineAligned="false"
    android:gravity="center_vertical">

    <!-- 左侧选择控件：checkbox / radio button -->
    <LinearLayout
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:minWidth="@dimen/settingslib_expressive_space_medium3"
        android:orientation="vertical" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingVertical="@dimen/settingslib_expressive_space_small1"
        android:paddingEnd="@dimen/settingslib_expressive_space_extrasmall6">

        <TextView
            android:id="@android:id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:hyphenationFrequency="normalFast"
            android:lineBreakWordStyle="phrase"
            android:maxLines="2"
            android:textAppearance="?android:attr/textAppearanceListItem" />

        <LinearLayout
            android:id="@+id/summary_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@android:id/summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAlignment="viewStart"
                android:textAppearance="?android:attr/textAppearanceListItemSecondary"
                android:textColor="?android:attr/textColorSecondary" />

            <TextView
                android:id="@+id/appendix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/settingslib_expressive_space_extrasmall4"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAlignment="viewEnd"
                android:textAppearance="?android:attr/textAppearanceSmall"
                android:textColor="?android:attr/textColorSecondary"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- 右侧额外控件（竖线 + 齿轮），和整行点击互不影响 -->
    <LinearLayout
        android:id="@+id/selector_extra_widget_container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width=".75dp"
            android:layout_height="32dp"
            android:background="?android:attr/dividerVertical" />

        <ImageView
            android:id="@+id/selector_extra_widget"
            android:layout_width="match_parent"
            android:layout_height="fill_parent"
            android:layout_gravity="center"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/settings_label"
            android:minWidth="@dimen/two_target_min_width"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:src="@drawable/ic_settings_accent" />
    </LinearLayout>
</LinearLayout>
